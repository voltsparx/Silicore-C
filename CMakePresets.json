{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "windows-msvc-tests",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-ninja",
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "linux-release-tests",
      "inherits": "linux-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-release",
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "termux-release",
      "inherits": "base",
      "generator": "Ninja"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-tests",
      "configurePreset": "windows-msvc-tests",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-release-tests",
      "configurePreset": "linux-release-tests"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "termux-release",
      "configurePreset": "termux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-tests",
      "configurePreset": "windows-msvc-tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release-tests",
      "configurePreset": "linux-release-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
